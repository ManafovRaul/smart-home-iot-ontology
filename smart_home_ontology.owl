        <hasManufacturer rdf:datatype="&xsd;string">TP-Link</hasManufacturer>
        <isOnline rdf:datatype="&xsd;boolean">true</isOnline>
        <rdfs:label xml:lang="en">Bedroom smart plug</rdfs:label>
        <rdfs:comment xml:lang="en">Currently powering an electric heater, hence the high power draw.</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#SecurityCamera_Garage">
        <rdf:type rdf:resource="#SecurityCamera"/>
        <isLocatedIn rdf:resource="#Garage_Main"/>
        <isConnectedTo rdf:resource="#HomeWiFi_5G"/>
        <monitors rdf:resource="#Garage_Main"/>
        <controlledBy rdf:resource="#Alice_Russo"/>
        <hasOwner rdf:resource="#Alice_Russo"/>
        <triggers rdf:resource="#Event_Motion_002"/>
        <hasIPAddress rdf:datatype="&xsd;string">192.168.1.25</hasIPAddress>
        <hasEnergyConsumption rdf:datatype="&xsd;float">4.8</hasEnergyConsumption>
        <hasManufacturer rdf:datatype="&xsd;string">Reolink</hasManufacturer>
        <isOnline rdf:datatype="&xsd;boolean">true</isOnline>
        <rdfs:label xml:lang="en">Garage security camera</rdfs:label>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#SmartBlinds_Bedroom">
        <rdf:type rdf:resource="#SmartBlinds"/>
        <isLocatedIn rdf:resource="#Bedroom_Master"/>
        <isConnectedTo rdf:resource="#Zigbee_Mesh"/>
        <controlledBy rdf:resource="#Alice_Russo"/>
        <hasOwner rdf:resource="#Alice_Russo"/>
        <hasAutomationRule rdf:resource="#Rule_MorningBlinds"/>
        <hasEnergyConsumption rdf:datatype="&xsd;float">2.1</hasEnergyConsumption>
        <hasManufacturer rdf:datatype="&xsd;string">IKEA</hasManufacturer>
        <isOnline rdf:datatype="&xsd;boolean">true</isOnline>
        <rdfs:label xml:lang="en">Bedroom smart blinds</rdfs:label>
    </owl:NamedIndividual>

    <!-- ================================================================== -->
    <!-- ABox: Gateway, Controller and composite device                     -->
    <!-- ================================================================== -->

    <owl:NamedIndividual rdf:about="#Gateway_Main">
        <rdf:type rdf:resource="#Gateway"/>
        <isLocatedIn rdf:resource="#Hallway_Entrance"/>
        <isConnectedTo rdf:resource="#HomeWiFi_5G"/>
        <isConnectedTo rdf:resource="#Zigbee_Mesh"/>
        <communicatesWith rdf:resource="#TempSensor_Kitchen"/>
        <communicatesWith rdf:resource="#MotionSensor_Hallway"/>
        <hasIPAddress rdf:datatype="&xsd;string">192.168.1.10</hasIPAddress>
        <hasFirmwareVersion rdf:datatype="&xsd;string">3.4.0</hasFirmwareVersion>
        <hasManufacturer rdf:datatype="&xsd;string">Raspberry Pi Foundation</hasManufacturer>
        <isOnline rdf:datatype="&xsd;boolean">true</isOnline>
        <rdfs:label xml:lang="en">Main home gateway</rdfs:label>
        <rdfs:comment xml:lang="en">Bridges the Wi-Fi and Zigbee networks. The double isConnectedTo assertion is the reason the property is not functional.</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#Controller_VoiceHub">
        <rdf:type rdf:resource="#Controller"/>
        <isLocatedIn rdf:resource="#LivingRoom_Main"/>
        <isConnectedTo rdf:resource="#HomeWiFi_5G"/>
        <communicatesWith rdf:resource="#Gateway_Main"/>
        <controlledBy rdf:resource="#Alice_Russo"/>
        <hasIPAddress rdf:datatype="&xsd;string">192.168.1.11</hasIPAddress>
        <hasManufacturer rdf:datatype="&xsd;string">Amazon</hasManufacturer>
        <isOnline rdf:datatype="&xsd;boolean">true</isOnline>
        <rdfs:label xml:lang="en">Voice-assistant hub</rdfs:label>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#ClimateStation_Bedroom">
        <rdf:type rdf:resource="#Device"/>
        <isLocatedIn rdf:resource="#Bedroom_Master"/>
        <isConnectedTo rdf:resource="#Zigbee_Mesh"/>
        <hasComponent rdf:resource="#TempSensor_Internal"/>
        <hasComponent rdf:resource="#FanActuator_Internal"/>
        <hasOwner rdf:resource="#Alice_Russo"/>
        <hasManufacturer rdf:datatype="&xsd;string">Xiaomi</hasManufacturer>
        <isOnline rdf:datatype="&xsd;boolean">true</isOnline>
        <rdfs:label xml:lang="en">Bedroom climate station</rdfs:label>
        <rdfs:comment xml:lang="en">Asserted only as a generic Device; the reasoner classifies it as a HybridDevice because it has both a Sensor and an Actuator component, and as a SmartDevice because it is connected to a network.</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#TempSensor_Internal">
        <rdf:type rdf:resource="#TemperatureSensor"/>
        <isLocatedIn rdf:resource="#Bedroom_Master"/>
        <hasTemperatureReading rdf:datatype="&xsd;float">21.0</hasTemperatureReading>
        <hasManufacturer rdf:datatype="&xsd;string">Xiaomi</hasManufacturer>
        <rdfs:label xml:lang="en">Climate-station internal thermometer</rdfs:label>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#FanActuator_Internal">
        <rdf:type rdf:resource="#Actuator"/>
        <isLocatedIn rdf:resource="#Bedroom_Master"/>
        <hasEnergyConsumption rdf:datatype="&xsd;float">12.0</hasEnergyConsumption>
        <hasManufacturer rdf:datatype="&xsd;string">Xiaomi</hasManufacturer>
        <rdfs:label xml:lang="en">Climate-station internal fan</rdfs:label>
    </owl:NamedIndividual>

    <!-- ================================================================== -->
    <!-- ABox: Events                                                       -->
    <!-- ================================================================== -->

    <owl:NamedIndividual rdf:about="#Event_Motion_001">
        <rdf:type rdf:resource="#SecurityEvent"/>
        <hasTimestamp rdf:datatype="&xsd;dateTime">2026-05-12T23:41:00</hasTimestamp>
        <rdfs:label xml:lang="en">Night motion event in hallway</rdfs:label>
        <rdfs:comment xml:lang="en">SWRL rule R1 infers occursIn Hallway_Entrance for this event from the location of the motion sensor that triggered it.</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#Event_Motion_002">
        <rdf:type rdf:resource="#SecurityEvent"/>
        <hasTimestamp rdf:datatype="&xsd;dateTime">2026-05-13T02:17:00</hasTimestamp>
        <occursIn rdf:resource="#Garage_Main"/>
        <rdfs:label xml:lang="en">Night motion event in garage</rdfs:label>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#Event_Smoke_001">
        <rdf:type rdf:resource="#Event"/>
        <hasTimestamp rdf:datatype="&xsd;dateTime">2026-04-30T19:05:00</hasTimestamp>
        <occursIn rdf:resource="#Kitchen_Main"/>
        <rdfs:label xml:lang="en">Smoke detection event</rdfs:label>
        <rdfs:comment xml:lang="en">Asserted only as a generic Event; SWRL rule R2 classifies it as a SecurityEvent because it was triggered by a smoke sensor.</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#Event_Humidity_001">
        <rdf:type rdf:resource="#EnvironmentEvent"/>
        <hasTimestamp rdf:datatype="&xsd;dateTime">2026-05-10T08:22:00</hasTimestamp>
        <occursIn rdf:resource="#Bathroom_Main"/>
        <rdfs:label xml:lang="en">High humidity event</rdfs:label>
    </owl:NamedIndividual>

    <!-- ================================================================== -->
    <!-- ABox: Automation rules                                             -->
    <!-- ================================================================== -->

    <owl:NamedIndividual rdf:about="#Rule_EveningLights">
        <rdf:type rdf:resource="#AutomationRule"/>
        <hasPriority rdf:datatype="&xsd;integer">2</hasPriority>
        <rdfs:label xml:lang="en">Evening lights rule</rdfs:label>
        <rdfs:comment xml:lang="en">Turn on the living-room lights at 30 percent brightness after sunset.</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#Rule_NightTemperature">
        <rdf:type rdf:resource="#AutomationRule"/>
        <hasPriority rdf:datatype="&xsd;integer">1</hasPriority>
        <rdfs:label xml:lang="en">Night temperature rule</rdfs:label>
        <rdfs:comment xml:lang="en">Lower the thermostat target to 18 degrees between 23:00 and 06:00.</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#Rule_MorningBlinds">
        <rdf:type rdf:resource="#AutomationRule"/>
        <hasPriority rdf:datatype="&xsd;integer">3</hasPriority>
        <rdfs:label xml:lang="en">Morning blinds rule</rdfs:label>
        <rdfs:comment xml:lang="en">Open the bedroom blinds at 07:30 on weekdays.</rdfs:comment>
    </owl:NamedIndividual>

    <!-- ================================================================== -->
    <!-- SWRL rules                                                         -->
    <!-- ================================================================== -->

    <swrl:Variable rdf:about="urn:swrl:var#s"/>
    <swrl:Variable rdf:about="urn:swrl:var#r"/>
    <swrl:Variable rdf:about="urn:swrl:var#e"/>
    <swrl:Variable rdf:about="urn:swrl:var#l"/>
    <swrl:Variable rdf:about="urn:swrl:var#u"/>

    <!-- R1: MotionSensor(?s) ^ isLocatedIn(?s,?r) ^ triggers(?s,?e) ^ SecurityEvent(?e) -> occursIn(?e,?r) -->
    <swrl:Imp rdf:about="#R1_MotionEventLocation">
        <rdfs:label xml:lang="en">R1: localise security events from motion sensors</rdfs:label>
        <rdfs:comment xml:lang="en">If a motion sensor located in a room triggers a security event, that event occurred in the same room.</rdfs:comment>
        <swrl:body>
            <swrl:AtomList>
                <rdf:first>
                    <swrl:ClassAtom>
                        <swrl:classPredicate rdf:resource="#MotionSensor"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#s"/>
                    </swrl:ClassAtom>
                </rdf:first>
                <rdf:rest>
                    <swrl:AtomList>
                        <rdf:first>
                            <swrl:IndividualPropertyAtom>
                                <swrl:propertyPredicate rdf:resource="#isLocatedIn"/>
                                <swrl:argument1 rdf:resource="urn:swrl:var#s"/>
                                <swrl:argument2 rdf:resource="urn:swrl:var#r"/>
                            </swrl:IndividualPropertyAtom>
                        </rdf:first>
                        <rdf:rest>
                            <swrl:AtomList>
                                <rdf:first>
                                    <swrl:IndividualPropertyAtom>
                                        <swrl:propertyPredicate rdf:resource="#triggers"/>
                                        <swrl:argument1 rdf:resource="urn:swrl:var#s"/>
                                        <swrl:argument2 rdf:resource="urn:swrl:var#e"/>
                                    </swrl:IndividualPropertyAtom>
                                </rdf:first>
                                <rdf:rest>
                                    <swrl:AtomList>
                                        <rdf:first>
                                            <swrl:ClassAtom>
                                                <swrl:classPredicate rdf:resource="#SecurityEvent"/>
                                                <swrl:argument1 rdf:resource="urn:swrl:var#e"/>
                                            </swrl:ClassAtom>
                                        </rdf:first>
                                        <rdf:rest rdf:resource="&rdf;nil"/>
                                    </swrl:AtomList>
                                </rdf:rest>
                            </swrl:AtomList>
                        </rdf:rest>
                    </swrl:AtomList>
                </rdf:rest>
            </swrl:AtomList>
        </swrl:body>
        <swrl:head>
            <swrl:AtomList>
                <rdf:first>
                    <swrl:IndividualPropertyAtom>
                        <swrl:propertyPredicate rdf:resource="#occursIn"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#e"/>
                        <swrl:argument2 rdf:resource="urn:swrl:var#r"/>
                    </swrl:IndividualPropertyAtom>
                </rdf:first>
                <rdf:rest rdf:resource="&rdf;nil"/>
            </swrl:AtomList>
        </swrl:head>
    </swrl:Imp>

    <!-- R2: SmokeSensor(?s) ^ triggers(?s,?e) -> SecurityEvent(?e) -->
    <swrl:Imp rdf:about="#R2_SmokeEventsAreSecurityEvents">
        <rdfs:label xml:lang="en">R2: smoke events are security events</rdfs:label>
        <rdfs:comment xml:lang="en">Every event triggered by a smoke sensor is a security event.</rdfs:comment>
        <swrl:body>
            <swrl:AtomList>
                <rdf:first>
                    <swrl:ClassAtom>
                        <swrl:classPredicate rdf:resource="#SmokeSensor"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#s"/>
                    </swrl:ClassAtom>
                </rdf:first>
                <rdf:rest>
                    <swrl:AtomList>
                        <rdf:first>
                            <swrl:IndividualPropertyAtom>
                                <swrl:propertyPredicate rdf:resource="#triggers"/>
                                <swrl:argument1 rdf:resource="urn:swrl:var#s"/>
                                <swrl:argument2 rdf:resource="urn:swrl:var#e"/>
                            </swrl:IndividualPropertyAtom>
                        </rdf:first>
                        <rdf:rest rdf:resource="&rdf;nil"/>
                    </swrl:AtomList>
                </rdf:rest>
            </swrl:AtomList>
        </swrl:body>
        <swrl:head>
            <swrl:AtomList>
                <rdf:first>
                    <swrl:ClassAtom>
                        <swrl:classPredicate rdf:resource="#SecurityEvent"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#e"/>
                    </swrl:ClassAtom>
                </rdf:first>
                <rdf:rest rdf:resource="&rdf;nil"/>
            </swrl:AtomList>
        </swrl:head>
    </swrl:Imp>

    <!-- R3: SmartLock(?l) ^ controlledBy(?l,?u) -> AdminUser(?u) -->
    <swrl:Imp rdf:about="#R3_LockControllersAreAdmins">
        <rdfs:label xml:lang="en">R3: lock controllers are administrators</rdfs:label>
        <rdfs:comment xml:lang="en">Access-control policy: any user authorised to control a smart lock must be an administrator.</rdfs:comment>
        <swrl:body>
            <swrl:AtomList>
                <rdf:first>
                    <swrl:ClassAtom>
                        <swrl:classPredicate rdf:resource="#SmartLock"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#l"/>
                    </swrl:ClassAtom>
                </rdf:first>
                <rdf:rest>
                    <swrl:AtomList>
                        <rdf:first>
                            <swrl:IndividualPropertyAtom>
                                <swrl:propertyPredicate rdf:resource="#controlledBy"/>
                                <swrl:argument1 rdf:resource="urn:swrl:var#l"/>
                                <swrl:argument2 rdf:resource="urn:swrl:var#u"/>
                            </swrl:IndividualPropertyAtom>
                        </rdf:first>
                        <rdf:rest rdf:resource="&rdf;nil"/>
                    </swrl:AtomList>
                </rdf:rest>
            </swrl:AtomList>
        </swrl:body>
        <swrl:head>
            <swrl:AtomList>
                <rdf:first>
                    <swrl:ClassAtom>
                        <swrl:classPredicate rdf:resource="#AdminUser"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#u"/>
                    </swrl:ClassAtom>
                </rdf:first>
                <rdf:rest rdf:resource="&rdf;nil"/>
            </swrl:AtomList>
        </swrl:head>
    </swrl:Imp>

</rdf:RDF>
