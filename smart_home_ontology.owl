        <hasAge rdf:datatype="&xsd;integer">38</hasAge>
        <rdfs:label xml:lang="en">Alice Russo</rdfs:label>
        <rdfs:comment xml:lang="en">Home owner and administrator of the smart home.</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#Bob_Verdi">
        <rdf:type rdf:resource="#GuestUser"/>
        <hasAge rdf:datatype="&xsd;integer">29</hasAge>
        <rdfs:label xml:lang="en">Bob Verdi</rdfs:label>
        <rdfs:comment xml:lang="en">A guest with temporary access to non-critical devices.</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#Marco_Russo">
        <rdf:type rdf:resource="#User"/>
        <hasAge rdf:datatype="&xsd;integer">9</hasAge>
        <rdfs:label xml:lang="en">Marco Russo</rdfs:label>
        <rdfs:comment xml:lang="en">Asserted only as a generic User with hasAge 9; the reasoner classifies him as ChildUser (and NonAdminUser) automatically through the datatype-restriction definition.</rdfs:comment>
    </owl:NamedIndividual>

